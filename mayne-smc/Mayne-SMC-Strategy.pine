//@version=6
// =============================================================================
// Trader Mayne SMC — Backtest Strategy (twin of Mayne-SMC-Indicator.pine)
// Version: 2.4 (2026-07-26) — versioned in lockstep with the indicator
// =============================================================================
// strategy() port of the indicator's engine so TradingView's Strategy Tester
// can score the signals: win rate, profit factor, drawdown, equity curve —
// and per-POI-type results (entry IDs are L-OB / L-FVG / S-OB / S-FVG, so the
// List of Trades tells you which zone kind actually performs).
//
// How it trades:
//   - A signal (same engine, same gates as the indicator) enters at the NEXT
//     bar's open (process_orders_on_close=false — no peeking), sized so the
//     distance to the stop risks `Risk per trade` % of current equity. Risk
//     is measured from the signal bar's CLOSE (the fill proxy); the RR
//     label/gate is computed at the zone trigger, so when the close pulled
//     away from the trigger the realized RR comes in under the labeled one.
//     That's the honest accounting — sizing off the trigger would over-risk.
//   - Every entry ships a bracket: stop = zone far edge -/+ the ATR buffer,
//     limit = the RR target (range extreme or nearest opposing zone).
//   - Opposite signals reverse the position; same-direction signals while
//     already positioned are skipped (pyramiding=0).
//   - Signals with no computable stop/target are SKIPPED (the indicator can
//     still label such retests when Min RR = 0) — every backtest trade has a
//     full bracket, so the Tester's numbers mean what they say.
//   - Margin is not simulated (TV default), so a tight stop can imply
//     notional > equity. If you would never lever, keep `Risk per trade`
//     small and sanity-check position sizes in the List of Trades.
//   - Commission defaults to 0.05%/side; set your venue's real fee in
//     Properties. Bars that span both stop and target resolve by TV's OHLC
//     heuristic — enable Bar Magnifier (paid plans) for finer fills.
//
// Differences from the indicator, on purpose:
//   - "Use FVGs / Order Blocks as POIs" removes that zone type from the
//     system entirely — backtest an OB-only or FVG-only variant.
//   - No zone table, no BUY/SELL labels, no alertconditions (the Tester's
//     trade markers and order-fill alerts replace them).
//
// SYNC POLICY: everything between the ENGINE markers is byte-identical to the
// same block in Mayne-SMC-Indicator.pine. Fix in one file, copy to the other.
// Study/testing tool, NOT financial advice.
// =============================================================================

VERSION = "2.4"
strategy("Trader Mayne SMC Strategy v" + VERSION, shorttitle="Mayne SMC Strat v" + VERSION, overlay=true, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.05, pyramiding=0, process_orders_on_close=false, max_boxes_count=500, max_labels_count=500)

// ---------------------------------------------------------------- Inputs ----
gS = "Market Structure / Bias"
swingLen  = input.int(2, "Swing length (pivot left/right)", minval=1, maxval=10, group=gS, tooltip="3-candle swing = 1. Higher = only bigger, more significant swings.")
atrLen    = input.int(14, "ATR length (displacement)", minval=1, group=gS)
dispMult  = input.float(1.5, "Displacement: candle range >= ATR x", minval=0.1, step=0.1, group=gS, tooltip="What counts as a strong/displacement candle.")
showBias  = input.bool(false, "Show range high/low + equilibrium lines", group=gS)
showStruct = input.bool(true, "Show MSB / MSS markers", group=gS, tooltip="MSB = structure break in the trend direction (continuation). MSS = first break against the trend (potential reversal).")
markerGap  = input.float(0.1, "Marker distance from candle (×ATR)", minval=0, step=0.05, group=gS, tooltip="How far MSB/MSS markers sit from the candle. Lower = closer/flush; 0 = right at the high/low.")
showTint  = input.bool(false, "Tint background by bias", group=gS, tooltip="Colours every bar green/red by trend.")

gF = "Fair Value Gaps"
showFvg    = input.bool(true, "Use FVGs as POIs (and draw them)", group=gF, tooltip="Off = FVG zones are neither drawn nor traded — backtest an OB-only system.")
fvgReqDisp = input.bool(true, "Require displacement on middle candle", group=gF)
fvgBullCol = input.color(color.new(color.blue, 90), "Bullish FVG", group=gF)
fvgBearCol = input.color(color.new(color.purple, 90), "Bearish FVG", group=gF)

gO = "Order Blocks"
showOb   = input.bool(true, "Use Order Blocks as POIs (and draw them)", group=gO, tooltip="Off = OB zones are neither drawn nor traded — backtest an FVG-only system.")
obReqBos = input.bool(true, "Only OBs whose move breaks structure", group=gO)
obBullCol = input.color(color.new(color.green, 90), "Bullish OB (demand)", group=gO)
obBearCol = input.color(color.new(color.red, 90), "Bearish OB (supply)", group=gO)

gZ = "Zone display"
freezeMit = input.bool(true, "Stop extending zones once mitigated", group=gZ, tooltip="A zone freezes (stops stretching to the present) once price trades into its 50% mean threshold. Keeps spent zones from blocking the chart; only untouched zones reach the live bar.")
zoneMaxAge = input.int(500, "Max zone age (bars, 0 = never)", minval=0, group=gZ, tooltip="A zone untouched for this many bars goes stale: its box freezes and it can no longer signal. 0 = zones live until invalidated.")

gG = "Signals"
useHalf   = input.bool(true, "Require correct half (discount/premium)", group=gG, tooltip="Longs only in discount, shorts only in premium — the Mayne rule.")
entryMid  = input.bool(true, "Trigger at zone 50% (mean threshold)", group=gG, tooltip="On = signal when price reaches the middle of the OB/FVG. Off = signal on first touch of the zone edge.")
htfTf     = input.timeframe("", "HTF bias timeframe (blank = off)", group=gG, tooltip="The master filter (guide §4): only fire signals that agree with the trend read on this higher timeframe. Must be HIGHER than the chart timeframe — equal or lower silently disables the gate. Uses the last CONFIRMED HTF bar, so it does not repaint but lags by one HTF bar. Blank = no HTF gate.")
confirmClose = input.bool(true, "Confirm signals on bar close", group=gG, tooltip="On = signals only fire when the bar closes; entries then fill on the next bar's open. Off = fire intra-bar on first touch (earlier, but can repaint within the live bar).")
useSweep  = input.bool(false, "Require liquidity sweep first", group=gG, tooltip="Guide §2: only take a long if price recently RAN the range low and closed back above it (rejection) — mirrored for shorts. Cuts signal count hard; off by default.")
sweepBars = input.int(20, "Sweep lookback (bars)", minval=1, maxval=200, group=gG, tooltip="How recent the sweep must be for the filter above.")
maxZones  = input.int(40, "Max zones tracked per side", minval=5, maxval=120, group=gG)

gR = "Risk / RR"
stopBuf    = input.float(0.25, "Stop buffer beyond far edge (×ATR)", minval=0, step=0.05, group=gR, tooltip="Stop for a long = zone bottom − this ×ATR (short: zone top + it). Also the bracket stop on every trade.")
targetMode = input.string("Range extreme", "Target for RR", options=["Range extreme", "Nearest opposing zone"], group=gR, tooltip="Range extreme = dealing-range high (longs) / low (shorts). Nearest opposing zone = near edge of the closest live supply (longs) / demand (shorts) beyond the entry, falling back to the range extreme when there is none. Also the bracket limit on every trade.")
minRR      = input.float(0, "Min RR to allow a signal (0 = off)", minval=0, step=0.25, group=gR, tooltip="Suppress signals whose reward:risk at the trigger is below this. RR = (target − entry) ÷ (entry − stop), entry = the trigger price.")

gB = "Backtest"
riskPct   = input.float(1.0, "Risk per trade (% of equity)", minval=0.05, maxval=100, step=0.25, group=gB, tooltip="Position size = this % of current equity divided by the entry→stop distance. Compounds with the equity curve.")
dateStart = input.time(timestamp("1 Jan 2018 00:00 +0000"), "Backtest start", group=gB)
dateEnd   = input.time(timestamp("1 Jan 2035 00:00 +0000"), "Backtest end", group=gB)

// Synthetic-OHLC chart types would fabricate structure, zones and signals.
if barstate.isfirst and not chart.is_standard
    runtime.error("Use a standard candles/bars chart — Heikin Ashi, Renko, Kagi, P&F and Range bars have synthetic prices, so SMC levels and signals would be fictitious.")

// ============================ ENGINE (shared) ================================
// This block is byte-identical in Mayne-SMC-Indicator.pine and
// Mayne-SMC-Strategy.pine — fix it in one file, copy it to the other.
// =============================================================================
BOX_LEAD = 3      // bars a live zone box projects past the current bar

// ------------------------------------------------------------- Core data ----
atr  = ta.atr(atrLen)
disp = (high - low) >= atr * dispMult                 // displacement candle

// ------------------------------------------------ Swings, structure, bias ---
ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)

var float rangeHigh = na      // last confirmed swing high (range top / BSL) — break level up
var float rangeLow  = na      // last confirmed swing low  (range bottom / SSL) — break level down
var bool  brokeHigh = true    // has the current swing high already been broken?
var bool  brokeLow  = true

if not na(ph)
    rangeHigh := ph
    brokeHigh := false
if not na(pl)
    rangeLow := pl
    brokeLow := false

// Trend state and the MSB / MSS distinction (guide §1):
//   MSB (continuation) = a break in the SAME direction as the current trend.
//   MSS (reversal)     = the FIRST break AGAINST the current trend; it flips the trend.
// Mechanically identical to the SMC BOS / CHoCH pair.
var int trend = 0             // 1 = bullish, -1 = bearish, 0 = undecided
breakUp = not na(rangeHigh) and not brokeHigh and close > rangeHigh
breakDn = not na(rangeLow)  and not brokeLow  and close < rangeLow

bullMSS = false               // break up that reverses a downtrend  (CHoCH up)
bullMSB = false               // break up that continues an uptrend  (BOS up)
bearMSS = false               // break down that reverses an uptrend (CHoCH down)
bearMSB = false               // break down that continues a downtrend (BOS down)

if breakUp
    brokeHigh := true
    if trend == -1
        bullMSS := true       // was bearish -> first up-break = reversal
    else
        bullMSB := true       // already bullish (or fresh) -> continuation
    trend := 1
if breakDn
    brokeLow := true
    if trend == 1
        bearMSS := true       // was bullish -> first down-break = reversal
    else
        bearMSB := true
    trend := -1

structBreakUp = bullMSB or bullMSS   // any up-break (qualifies a bullish OB)
structBreakDn = bearMSB or bearMSS

// dealing range + equilibrium (the 50%)
validRange = not na(rangeHigh) and not na(rangeLow) and rangeHigh > rangeLow
eq = validRange ? (rangeHigh + rangeLow) / 2 : na
inDiscount = not na(eq) and close < eq
inPremium  = not na(eq) and close > eq

plot(showBias and not na(rangeHigh) ? rangeHigh : na, "Range High (BSL)", color.new(color.gray, 0), 1, plot.style_linebr)
plot(showBias and not na(rangeLow)  ? rangeLow  : na, "Range Low (SSL)",  color.new(color.gray, 0), 1, plot.style_linebr)
plot(showBias and not na(eq) ? eq : na, "Equilibrium (50%)", color.new(color.orange, 30), 1, plot.style_linebr)

// ----------------------------------------------------------- HTF bias gate --
// Same swing/break trend logic as above, self-contained so request.security
// can run it on the higher timeframe (guide §4: the HTF is the boss).
f_trend() =>
    _ph = ta.pivothigh(swingLen, swingLen)
    _pl = ta.pivotlow(swingLen, swingLen)
    var float _rh = na
    var float _rl = na
    var bool  _bh = true
    var bool  _bl = true
    var int   _t  = 0
    if not na(_ph)
        _rh := _ph
        _bh := false
    if not na(_pl)
        _rl := _pl
        _bl := false
    if not na(_rh) and not _bh and close > _rh
        _bh := true
        _t  := 1
    if not na(_rl) and not _bl and close < _rl
        _bl := true
        _t  := -1
    _t

// [1] + lookahead_on = the canonical non-repainting HTF fetch: always the last
// CONFIRMED HTF bar, never the developing one. With lookahead_off the [1] value
// arrives one HTF bar later on historical bars than in realtime, so backtests
// would run a staler bias than live. The [1] offset is what makes lookahead_on
// safe — never change one without the other.
htfTrend = request.security(syminfo.tickerid, htfTf == "" ? timeframe.period : htfTf, f_trend()[1], lookahead=barmerge.lookahead_on)
// Gate only engages when the selected TF is strictly HIGHER than the chart's —
// security() on an equal/lower TF returns junk, so those silently disable it.
htfOn = htfTf != "" and timeframe.in_seconds(htfTf) > timeframe.in_seconds(timeframe.period)

// ------------------------------------------------------- Liquidity sweeps ---
// Guide §2: a sweep = price RUNS the level but closes back on the original
// side (rejection). Tracked on the current unbroken swing high/low. The
// displacement leg the guide also wants is partly enforced downstream (OBs
// require displacement; FVGs optionally) — this is a mechanical approximation.
var int lastBullSweep = na    // bar of the last run on the range low that got rejected
var int lastBearSweep = na    // bar of the last run on the range high that got rejected
if not na(rangeLow) and not brokeLow and low < rangeLow and close > rangeLow
    lastBullSweep := bar_index
if not na(rangeHigh) and not brokeHigh and high > rangeHigh and close < rangeHigh
    lastBearSweep := bar_index
bullSweepOk = not na(lastBullSweep) and bar_index - lastBullSweep <= sweepBars
bearSweepOk = not na(lastBearSweep) and bar_index - lastBearSweep <= sweepBars

// ------------------------------------------------------------ Zone model ----
// One type replaces the old set of parallel arrays. Objects are references, so
// the manage/render helpers below mutate fields in place (no array.set needed).
type Zone
    float  top
    float  bot
    bool   done       // a signal has already fired off this zone
    bool   mit        // price has reached the 50% (zone is "mitigated"/spent)
    string kind       // "OB" or "FVG"
    bool   isBull     // demand (buy) vs supply (sell)
    box    bx
    int    created    // bar the zone was confirmed — no signal on this bar (a retest needs price to LEAVE first)

var array<Zone> bullZones = array.new<Zone>()   // demand
var array<Zone> bearZones = array.new<Zone>()   // supply

// The price level a signal fires at: the 50% mean threshold, or the near edge.
trigOf(Zone z) => entryMid ? (z.top + z.bot) / 2 : (z.isBull ? z.top : z.bot)

// The edge price touches first coming back to the zone (demand: top, supply: bottom).
edgeOf(Zone z) => z.isBull ? z.top : z.bot

// Stop for a trade off this zone: just beyond the far edge, ATR-buffered.
stopOf(Zone z) => z.isBull ? z.bot - atr * stopBuf : z.top + atr * stopBuf

// Near edge of the closest LIVE opposing zone past `beyond` (na if none).
oppEdge(array<Zone> opp, bool isBull, float beyond) =>
    best = float(na)
    for z in opp
        if not z.done and not z.mit
            e = edgeOf(z)
            if (isBull ? e > beyond : e < beyond) and (na(best) or (isBull ? e < best : e > best))
                best := e
    best

// RR target: the dealing-range extreme, or the nearest live opposing zone's
// near edge (falling back to the extreme when none lies beyond the entry).
targetFor(Zone z, array<Zone> opp) =>
    ext = z.isBull ? rangeHigh : rangeLow
    targetMode == "Nearest opposing zone" ? nz(oppEdge(opp, z.isBull, trigOf(z)), ext) : ext

// Reward:risk at `entry` for the bracket [stp, tgt]; na when incomputable.
rrOf(float entry, float stp, float tgt, bool isBull) =>
    risk = isBull ? entry - stp : stp - entry
    rew  = isBull ? tgt - entry : entry - tgt
    risk > 0 and not na(rew) ? rew / risk : float(na)

addZone(array<Zone> zones, bool isBull, int left, float top, float bot, color col, string kind) =>
    bx = box.new(left, top, bar_index + BOX_LEAD, bot, border_color=color.new(col, 40), bgcolor=col)
    array.push(zones, Zone.new(top, bot, false, false, kind, isBull, bx, bar_index))
    if array.size(zones) > maxZones
        box.delete(array.shift(zones).bx)

// Drop invalidated zones, freeze/extend the rest, and flag a retest signal.
// Returns [fired, kind, rr, stop, target] for the zone that fired this bar.
manageZones(array<Zone> zones, array<Zone> opp) =>
    sig = false
    sigKind = ""
    sigRR   = float(na)
    sigStop = float(na)
    sigTgt  = float(na)
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            z = array.get(zones, i)
            mid = (z.top + z.bot) / 2
            invalid = z.isBull ? close < z.bot : close > z.top
            expired = zoneMaxAge > 0 and bar_index - z.created > zoneMaxAge
            if invalid
                array.remove(zones, i)
                box.delete(z.bx)         // remove first so the block ends on a void call
            else if expired
                array.remove(zones, i)   // stale: stop tracking (no table, no signals)...
                if not z.mit or not freezeMit
                    box.set_right(z.bx, bar_index)   // ...but keep the box, frozen where it died
            else
                wasMit = z.mit               // 50% already consumed on an EARLIER bar -> zone is spent
                // Touches count only AFTER the creation bar: the displacement candle that
                // confirms an OB usually opens inside it, so counting the creation bar's own
                // range would mark most OBs mitigated at birth (never able to signal).
                reached = bar_index > z.created and (z.isBull ? low <= mid : high >= mid)
                if not z.mit and reached
                    z.mit := true
                    if freezeMit
                        box.set_right(z.bx, bar_index)          // spent -> freeze here
                else if not freezeMit or not z.mit
                    box.set_right(z.bx, bar_index + BOX_LEAD)    // still live -> keep extending
                trig = trigOf(z)
                isRetest = bar_index > z.created                 // not the bar that built the zone
                barOk  = not confirmClose or barstate.isconfirmed
                dirOk  = z.isBull ? trend == 1 : trend == -1
                htfOk  = not htfOn or (z.isBull ? htfTrend == 1 : htfTrend == -1)
                locOk  = z.isBull ? (not useHalf or inDiscount) : (not useHalf or inPremium)
                swpOk  = not useSweep or (z.isBull ? bullSweepOk : bearSweepOk)
                hitTrig = z.isBull ? low <= trig : high >= trig
                if not z.done and not wasMit and hitTrig and isRetest and barOk and dirOk and htfOk and locOk and swpOk
                    stp = stopOf(z)
                    tgt = targetFor(z, opp)
                    rr  = rrOf(trig, stp, tgt, z.isBull)
                    if minRR == 0 or (not na(rr) and rr >= minRR)
                        sig := true
                        sigKind := z.kind
                        sigRR := rr
                        sigStop := stp
                        sigTgt := tgt
                        z.done := true
    [sig, sigKind, sigRR, sigStop, sigTgt]

// ------------------------------------------------------ Fair Value Gaps -----
// 3-candle imbalance. Indices: candle1=[2], displacement=[1], candle3=[0].
bullFvg = low > high[2] and (not fvgReqDisp or (close[1] > open[1] and disp[1]))
bearFvg = high < low[2]  and (not fvgReqDisp or (close[1] < open[1] and disp[1]))

if showFvg and bullFvg
    addZone(bullZones, true,  bar_index - 2, low, high[2], fvgBullCol, "FVG")   // gap: high[2] (bottom) -> low[0] (top)
if showFvg and bearFvg
    addZone(bearZones, false, bar_index - 2, low[2], high, fvgBearCol, "FVG")   // gap: high[0] (bottom) -> low[2] (top)

// -------------------------------------------------------- Order Blocks ------
// Track the most recent opposite-direction candle, then claim it when a
// structure-breaking displacement fires. Claimed candles are cleared so two
// displacement bars in a row can't stamp the same OB twice.
var float lastDownHi  = na
var float lastDownLo  = na
var int   lastDownBar = na
var float lastUpHi    = na
var float lastUpLo    = na
var int   lastUpBar   = na
if close < open
    lastDownHi  := high
    lastDownLo  := low
    lastDownBar := bar_index
if close > open
    lastUpHi  := high
    lastUpLo  := low
    lastUpBar := bar_index

obBullTrig = showOb and disp and close > open and (not obReqBos or structBreakUp)
obBearTrig = showOb and disp and close < open and (not obReqBos or structBreakDn)
if obBullTrig and not na(lastDownHi)
    addZone(bullZones, true, lastDownBar, lastDownHi, lastDownLo, obBullCol, "OB")   // demand
    lastDownHi  := na
    lastDownLo  := na
    lastDownBar := na
if obBearTrig and not na(lastUpHi)
    addZone(bearZones, false, lastUpBar, lastUpHi, lastUpLo, obBearCol, "OB")        // supply
    lastUpHi  := na
    lastUpLo  := na
    lastUpBar := na

// --------------------------------------------- Manage zones + fire signals --
[buySig, buyKind, buyRR, buyStop, buyTgt]      = manageZones(bullZones, bearZones)
[sellSig, sellKind, sellRR, sellStop, sellTgt] = manageZones(bearZones, bullZones)
// ========================== END ENGINE (shared) ==============================

// ------------------------------------------------------------- Plotting -----
// Absolute (ATR-scaled) offsets pin markers a fixed distance from the candle,
// instead of letting belowbar/abovebar stack them into far-off lanes.
gap  = atr * markerGap
yBelow = low  - gap                   // MSB dots — near-flush to the bar
yAbove = high + gap
yBelowFar = low  - gap - atr * 0.12   // MSS labels — just outside the dots
yAboveFar = high + gap + atr * 0.12

// Structure breaks: MSB = continuation (dot), MSS = reversal/CHoCH (label text).
plotshape(showStruct and bullMSB ? yBelow : na, "MSB up",   shape.circle, location.absolute, color.new(color.green, 0),  size=size.tiny)
plotshape(showStruct and bearMSB ? yAbove : na, "MSB down", shape.circle, location.absolute, color.new(color.red, 0),    size=size.tiny)
plotshape(showStruct and bullMSS ? yBelowFar : na, "MSS up",   shape.labelup,   location.absolute, color.new(color.lime, 0),   text="MSS", textcolor=color.black, size=size.tiny)
plotshape(showStruct and bearMSS ? yAboveFar : na, "MSS down", shape.labeldown, location.absolute, color.new(color.orange, 0), text="MSS", textcolor=color.black, size=size.tiny)

bgcolor(showTint ? (trend == 1 ? color.new(color.green, 94) : trend == -1 ? color.new(color.red, 94) : na) : na, title="Bias tint")

// -------------------------------------------------------------- Orders ------
inRange = time >= dateStart and time <= dateEnd

// Every trade needs the full bracket: signals without a computable stop AND
// target are skipped here (the indicator can still label them when Min RR = 0).
// buySig and sellSig can't fire on the same bar (dirOk needs opposite trends).
// Sizing measures risk from `close` (≈ the next-open fill), not the zone
// trigger the RR label uses — fills happen at market, not at the trigger.
if buySig and inRange and strategy.position_size <= 0 and not na(buyStop) and not na(buyTgt)
    riskPerUnit = close - buyStop
    if riskPerUnit > 0 and buyTgt > close
        qty = strategy.equity * riskPct / 100 / riskPerUnit
        if qty > 0
            strategy.entry("L-" + buyKind, strategy.long, qty=qty)
            strategy.exit("XL-" + buyKind, from_entry="L-" + buyKind, stop=buyStop, limit=buyTgt)

if sellSig and inRange and strategy.position_size >= 0 and not na(sellStop) and not na(sellTgt)
    riskPerUnit = sellStop - close
    if riskPerUnit > 0 and sellTgt < close
        qty = strategy.equity * riskPct / 100 / riskPerUnit
        if qty > 0
            strategy.entry("S-" + sellKind, strategy.short, qty=qty)
            strategy.exit("XS-" + sellKind, from_entry="S-" + sellKind, stop=sellStop, limit=sellTgt)
